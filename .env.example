# =============================================================================
# pt-orchestrator — environment configuration template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app reads this file on startup (loaded by start-app.sh on Mac/Linux,
# or set as system environment variables on Windows).
# =============================================================================

# ── Active Spring Profile ─────────────────────────────────────────────────────
# h2       → embedded H2 database, zero setup, data/orchestratordb file on disk
# postgres → external PostgreSQL (fill DATABASE_* vars below)
SPRING_PROFILES_ACTIVE=h2

# ── Secrets store encryption key (AES-256) ────────────────────────────────────
# MUST stay constant across restarts — if this changes, all stored secrets
# become unreadable. Regenerate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=your_aes256_base64_key_here

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow scopes
GITHUB_TOKEN=your_github_token_here

# ── Jenkins ───────────────────────────────────────────────────────────────────
# Full URL to your Jenkins server (no trailing slash)
# Examples:
#   Local machine / Docker:  http://localhost:9090
#   VDI / remote server:     http://your-jenkins-server:9090
JENKINS_URL=http://your-jenkins-server:9090
JENKINS_USER=your_jenkins_username
JENKINS_TOKEN=your_jenkins_api_token_here

# ── PostgreSQL (only needed when SPRING_PROFILES_ACTIVE=postgres) ─────────────
# DATABASE_URL=jdbc:postgresql://your-db-host:5432/orchestrator
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
