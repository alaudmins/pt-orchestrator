# Example .env file for pt-orchestrator

# ===========================================
# External Database Configuration
# ===========================================
# Uncomment and configure these to use an external PostgreSQL database

# For database on host machine (from Docker container)
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/orchestrator
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# For remote PostgreSQL server
# DATABASE_URL=jdbc:postgresql://your-db-server:5432/orchestrator
# DATABASE_USER=your_db_user
# DATABASE_PASSWORD=your_db_password

# For cloud-hosted database (AWS RDS, Azure PostgreSQL, etc.)
# DATABASE_URL=jdbc:postgresql://your-cloud-db.region.provider.com:5432/orchestrator
# DATABASE_USER=admin
# DATABASE_PASSWORD=secure_password

# ===========================================
# Application Credentials
# ===========================================

# GitHub Personal Access Token (required for GitHub workflow integration)
GITHUB_TOKEN=your_github_token_here

# Jenkins Configuration
JENKINS_URL=http://host.docker.internal:9090
JENKINS_USER=pt-orch
JENKINS_TOKEN=your_jenkins_token_here
